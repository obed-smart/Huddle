<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
  <title>Huddle — Meet</title>
  <link rel="stylesheet" href="/css/base.css?v=<%= Date.now() %>" />
  <link rel="stylesheet" href="/css/call.css?v=<%= Date.now() %>" />
</head>
<body class="call-body">

  <div class="call" id="callRoot">
    <!-- MEET = bento grid of everyone. Tap a tile's expand button to
         fullscreen just that person; tap again to return. -->
    <div class="grid" id="grid"></div>
    <div class="sharing hidden" id="sharing">Sharing your screen</div>

    <div class="call-top">
      <button class="back" id="backBtn" data-icon="arrow-left"></button>
      <div>
        <div class="call-name" id="callName"></div>
        <div class="call-status">Meet · <span id="callStatus">00:00</span></div>
      </div>
      <div class="top-actions">
        <button class="top-btn" id="peopleBtn" data-icon="users"></button>
      </div>
    </div>

    <!-- floating emoji layer (reactions fly up through this) -->
    <div class="react-layer" id="reactLayer"></div>
    <div class="react-bar" id="reactBar"></div>

    <div class="dev-call">
      <button id="devJoin">+ peer</button>
      <button id="devLeave">− peer</button>
      <button id="devReact">peer reacts</button>
    </div>

    <div class="controls">
      <button class="ctrl" id="micBtn" data-icon="mic"></button>
      <button class="ctrl" id="camBtn" data-icon="video"></button>
      <button class="ctrl" id="shareBtn" data-icon="screen-share"></button>
      <button class="ctrl" id="chatBtn" data-icon="message"></button>
      <button class="ctrl" id="reactBtn" data-icon="smile"></button>
      <button class="ctrl end" id="endBtn" data-icon="phone-off"></button>
    </div>

    <!-- participants: meet only -->
    <div class="panel" id="peoplePanel">
      <div class="panel-head">
        <h3>In this meet · <span id="pCount">0</span></h3>
        <button class="iconbtn" id="peopleClose" data-icon="x"></button>
      </div>
      <div class="panel-body" id="peopleBody"></div>
    </div>

    <!-- chat + files: meet only -->
    <div class="panel" id="chatPanel">
      <div class="panel-head">
        <h3>Chat</h3>
        <button class="iconbtn" id="chatClose" data-icon="x"></button>
      </div>
      <div class="panel-body" id="meetLog"></div>
      <div class="panel-foot">
        <input type="text" id="meetInput" placeholder="Message" autocomplete="off" />
        <button id="fileBtn" data-icon="paperclip"></button>
        <button class="send" id="meetSend" data-icon="send"></button>
        <input type="file" id="fileInput" class="sr-only" />
      </div>
    </div>
  </div>

  <script src="/js/boot.js?v=<%= Date.now() %>"></script>
  <script src="/js/icons.js?v=<%= Date.now() %>"></script>
  <script src="/js/demo.js?v=<%= Date.now() %>"></script>
  <script src="/js/common.js?v=<%= Date.now() %>"></script>
  <script src="/js/call-state.js?v=<%= Date.now() %>"></script>
  <script src="/js/media.js?v=<%= Date.now() %>"></script>
  <script src="/js/grid.js?v=<%= Date.now() %>"></script>
  <script src="/js/call-ui.js?v=<%= Date.now() %>"></script>
  <script src="/js/meet.js?v=<%= Date.now() %>"></script>
</body>
</html>
