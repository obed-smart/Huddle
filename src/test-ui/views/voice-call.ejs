<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
  <title>Huddle — Voice call</title>
  <link rel="stylesheet" href="/css/base.css?v=<%= Date.now() %>" />
  <link rel="stylesheet" href="/css/call.css?v=<%= Date.now() %>" />
</head>
<body class="call-body">

  <div class="call" id="callRoot">
    <div class="stage" id="stage"></div>
    <div class="stage-label" id="stageLabel"></div>

    <div class="call-top">
      <!-- BACK leaves the screen; the call KEEPS RUNNING.
           Only the red end button ends it. -->
      <button class="back" id="backBtn" data-icon="arrow-left"></button>
      <div>
        <div class="call-name" id="callName"></div>
        <div class="call-status">Voice · <span id="callStatus">Calling…</span></div>
      </div>
    </div>

    <!-- floating PIP cards; tap one to swap it onto the stage -->
    <div class="strip" id="strip"></div>

    <!-- floating emoji layer (reactions fly up through this) -->
    <div class="react-layer" id="reactLayer"></div>
    <div class="react-bar" id="reactBar"></div>

    <!-- outgoing: waiting on them -->
    <div class="prompt up-waiting" id="upWaiting">
      <div class="t">Asking <span id="upWaitingWho"></span> for video…</div>
      <div class="s">They can stay on voice if they prefer.</div>
      <button id="upCancel">Cancel</button>
    </div>

    <!-- incoming: they asked you -->
    <div class="prompt up-prompt" id="upPrompt">
      <div class="t"><span data-icon="video"></span>
        <span><b id="upPromptWho"></b> wants to switch to video</span></div>
      <div class="up-actions">
        <button class="up-accept" id="upAccept">Turn on camera</button>
        <button class="up-decline" id="upDecline">Stay on voice</button>
      </div>
    </div>

    <div class="dev-call">
      <button id="devJoin">+ peer</button>
      <button id="devLeave">− peer</button>
      <button id="devReact">peer reacts</button>
      <button id="devAskVideo">they ask video</button>
      <button id="devAcceptVideo">they accept</button>
    </div>

    <div class="controls">
      <button class="ctrl" id="micBtn" data-icon="mic"></button>
      <!-- Sits where a video call's camera button sits, in its OFF
           state — because on a voice call the camera really is off.
           Tapping it ASKS for video; it does not switch anything on. -->
      <button class="ctrl off" id="upgradeBtn" data-icon="video-off" title="Ask to turn on video"></button>

      <button class="ctrl" id="reactBtn" data-icon="smile"></button>
      <button class="ctrl end" id="endBtn" data-icon="phone-off"></button>
    </div>
  </div>

  <script src="/js/boot.js?v=<%= Date.now() %>"></script>
  <script src="/js/icons.js?v=<%= Date.now() %>"></script>
  <script src="/js/demo.js?v=<%= Date.now() %>"></script>
  <script src="/js/common.js?v=<%= Date.now() %>"></script>
  <script src="/js/call-state.js?v=<%= Date.now() %>"></script>
  <script src="/js/media.js?v=<%= Date.now() %>"></script>
  <script src="/js/stage.js?v=<%= Date.now() %>"></script>
  <script src="/js/call-ui.js?v=<%= Date.now() %>"></script>
  <script src="/js/upgrade.js?v=<%= Date.now() %>"></script>
  <script src="/js/voice-call.js?v=<%= Date.now() %>"></script>
</body>
</html>
