<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Huddle</title>
    <link rel="stylesheet" href="/css/base.css?v=<%= Date.now() %>" />
    <link rel="stylesheet" href="/css/shell.css?v=<%= Date.now() %>" />
  </head>
  <body class="shell">
    <div class="login-wrap">
      <div class="login-card">
        <h1>Huddle</h1>
        <p>Sign in to continue.</p>

        <!-- TODO: point at your real auth endpoint -->
        <form method="POST" action="/api/v1/auth/login">
          <!-- Change name="username" to name="identifier" to match your Postman body -->
          <input
            class="field"
            type="text"
            name="identifier"
            placeholder="Username or email"
            autocomplete="username"
            required
          />

          <input
            class="field"
            type="password"
            name="password"
            placeholder="Password"
            autocomplete="current-password"
            required
          />
          <button class="btn" type="submit">Log in</button>
        </form>

        <div class="divider">or</div>

        <form method="POST" action="/demo-login">
          <button class="btn secondary" type="submit">
            Continue as demo user
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
