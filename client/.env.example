# Copy this file to .env.local and fill in your backend origin.

# The backend origin, SERVER ONLY (no NEXT_PUBLIC prefix, never shipped to the
# browser). REST is proxied same-origin to this (the /api/v1 rewrite, or the
# route handler at app/api/v1/[...path]), so the session cookie stays first
# party for REST (no CORS there).
BACKEND_ORIGIN=http://localhost:5000

# The backend origin for the SOCKET, PUBLIC (the browser needs it). A websocket
# cannot be proxied cleanly through Next, so the socket connects straight to the
# backend over websocket. This is not a secret; the only credential is the
# httpOnly cookie. Your backend's Socket.IO CORS must allow this frontend origin
# WITH credentials, so the handshake carries the cookie. In production, a cross
# site cookie also needs SameSite=None; Secure. Empty falls back to same origin.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional. An extra socket origin for the CSP connect-src, if ever different
# from NEXT_PUBLIC_SOCKET_URL. Normally left unset.
# BACKEND_WS_ORIGIN=
