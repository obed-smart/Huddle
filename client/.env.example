# Copy this file to .env.local and fill in your backend URL.

# The backend origin. The client connects to it directly for both the REST API
# and the Socket.IO connection. It is public (not a secret); the only credential
# is the httpOnly session cookie. The socket.io client appends its own
# /socket.io path to this origin automatically.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional. Only for a same origin deployment where a reverse proxy serves the
# API on the app's own host, or for the server side first paint reads. Leave it
# unset when connecting directly with NEXT_PUBLIC_API_URL above.
# BACKEND_ORIGIN=

# Optional. A distinct socket origin for the CSP connect-src, if the socket ever
# lives somewhere other than NEXT_PUBLIC_API_URL.
# BACKEND_WS_ORIGIN=

# Backend requirements for the direct cross origin setup (these are backend
# config, not frontend):
#   - CORS allows this frontend origin WITH credentials.
#   - The session cookie is set SameSite=None; Secure so the browser sends it on
#     cross origin REST and socket requests.
