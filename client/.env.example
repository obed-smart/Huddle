# Copy this file to .env.local and fill in your backend origin.

# The backend origin, SERVER ONLY (no NEXT_PUBLIC prefix, never shipped to the
# browser). The Next server is a Backend for Frontend: the route handler at
# app/api/v1/[...path] forwards same-origin /api/v1 calls to this origin, a
# rewrite proxies /socket.io to it, and the server components read from it for
# the first paint. The browser only ever sees our own origin, so the session
# cookie stays first party (no CORS, no SameSite=None).
#
# One backend expectation: set the session cookie host only (no explicit Domain)
# so the browser keeps it under our origin as the BFF relays it.
BACKEND_ORIGIN=http://localhost:5000

# Optional. A distinct socket origin for the CSP connect-src, only if the socket
# is served from somewhere other than our own origin. Normally left unset.
# BACKEND_WS_ORIGIN=
